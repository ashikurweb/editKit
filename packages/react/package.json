  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@editkit/core": "workspace:*",
    "@editkit/ui": "workspace:*"
  },
  "devDependencies": {
