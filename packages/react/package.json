    "url": "https://github.com/ashikurweb/vellora-editor/issues"
  },
  "keywords": [
    "editkit",
    "editkit-react",
    "@editkit/react",
    "react-editor",
    "react-rich-text-editor",
    "rich-text-editor",
    "wysiwyg",
    "wysiwyg-editor",
    "tiptap-alternative",
    "quill-alternative",
    "lexical-alternative",
    "slate-alternative",
