{
  "name": "@editkit/react",
  "version": "1.0.6",
  "description": "React and Next.js rich text editor with tables, color picker, bubble menu, and no third-party editor engine. A TypeScript alternative to TipTap, Quill, Lexical, and Slate.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashikurweb/editKit-text-editor.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/ashikurweb/editKit-text-editor#readme",
  "bugs": {
    "url": "https://github.com/ashikurweb/editKit-text-editor/issues"
  },
  "keywords": [
    "editkit",
    "editkit-text-editor",
    "editkit-react",
    "@editkit/react",
    "react-editor",
    "react-rich-text-editor",
    "rich-text-editor",
    "wysiwyg",
    "wysiwyg-editor",
    "tiptap-alternative",
    "quill-alternative",
    "lexical-alternative",
    "slate-alternative",
    "notion-style-editor",
    "table-editor",
    "nextjs-editor",
    "react-19",
    "contenteditable",
    "zero-dependencies",
    "headless-editor",
    "markdown-editor",
    "document-editor"
  ],
  "license": "MIT",
  "author": "Ashikur Rahman",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --target es2022 --external @editkit/core --external @editkit/ui --external react --external react-dom"
  },
  "peerDependencies": {
    "react": ">=16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": ">=16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@editkit/core": "workspace:*",
    "@editkit/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.3"
  }
}
