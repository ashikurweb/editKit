{
  "name": "@editkit/core",
  "version": "1.0.8",
  "description": "EditKit Core Engine — Zero-dependency, framework-agnostic rich text editor in pure TypeScript. Fast, extensible alternative to ProseMirror, Quill, Lexical & Slate.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashikurweb/editKit-text-editor.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ashikurweb/editKit-text-editor#readme",
  "bugs": {
    "url": "https://github.com/ashikurweb/editKit-text-editor/issues"
  },
  "keywords": [
    "editkit",
    "editkit-text-editor",
    "editkit-core",
    "@editkit/core",
    "editor",
    "rich-text",
    "rich-text-editor",
    "wysiwyg",
    "wysiwyg-editor",
    "contenteditable",
    "framework-agnostic",
    "zero-dependencies",
    "headless-editor"
  ],
  "license": "MIT",
  "author": "Ashikur Rahman",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --target es2022",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
