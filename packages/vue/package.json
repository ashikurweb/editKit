  },
  "homepage": "https://github.com/ashikurweb/editKit#readme",
  "bugs": {
    "url": "https://github.com/ashikurweb/editKit/issues"
  },
  "keywords": [
    "editkit",
    "editkit-vue",
    "@editkit/vue",
    "vue",
    "vue3",
    "vue-editor",
    "vue-rich-text-editor",
    "rich-text-editor",
    "wysiwyg",
    "wysiwyg-editor",
    "nuxt",
    "nuxt3",
    "tiptap-vue",
    "quill-vue",
    "notion-style-editor",
    "table-editor",
    "contenteditable",
    "zero-dependencies"
  ],
  "license": "MIT",
  "author": "Ashikur Rahman",
