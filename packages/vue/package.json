{
  "name": "@editkit/vue",
  "version": "1.0.8",
  "description": "Vue 3 and Nuxt rich text editor with components, composables, tables, and no third-party editor engine. A TypeScript alternative to TipTap and Quill.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashikurweb/editKit-text-editor.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/ashikurweb/editKit-text-editor#readme",
  "bugs": {
    "url": "https://github.com/ashikurweb/editKit-text-editor/issues"
  },
  "keywords": [
    "editkit",
    "editkit-text-editor",
    "editkit-vue",
    "@editkit/vue",
    "vue",
    "vue3",
    "vue-editor",
    "vue-rich-text-editor",
    "rich-text-editor",
    "wysiwyg",
    "wysiwyg-editor",
    "nuxt",
    "nuxt3",
    "nuxt-editor",
    "nuxt-rich-text-editor",
    "laravel-inertia-vue",
    "tiptap-vue",
    "quill-vue",
    "notion-style-editor",
    "table-editor",
    "contenteditable"
  ],
  "license": "MIT",
  "author": "Ashikur Rahman",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --target es2022 --external @editkit/core --external @editkit/ui --external vue",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@editkit/core": "workspace:*",
    "@editkit/ui": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vue": "^3.5.13"
  }
}
