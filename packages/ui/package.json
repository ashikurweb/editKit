{
  "name": "@editkit/ui",
  "version": "1.0.6",
  "description": "EditKit UI Components — Modern Toolbar, Floating Bubble Menu, Table Menu, 2D Color Picker & Pure CSS Theme Engine.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./src/styles/editor.css",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": {
      "types": "./src/styles/editor.d.ts",
      "default": "./src/styles/editor.css"
    },
    "./styles.css": {
      "types": "./src/styles/editor.d.ts",
      "default": "./src/styles/editor.css"
    }
  },
  "files": [
    "dist",
    "src/styles/editor.css",
    "src/styles/editor.d.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashikurweb/editKit-text-editor.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/ashikurweb/editKit-text-editor#readme",
  "bugs": {
    "url": "https://github.com/ashikurweb/editKit-text-editor/issues"
  },
  "keywords": [
    "editkit",
    "editkit-text-editor",
    "editkit-ui",
    "@editkit/ui",
    "editor-ui",
    "toolbar",
    "bubble-menu",
    "rich-text-ui",
    "theme",
    "color-picker",
    "table-ui"
  ],
  "license": "MIT",
  "author": "Ashikur Rahman",
  "sideEffects": [
    "./src/styles/editor.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --target es2022 --external @editkit/core",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@editkit/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
