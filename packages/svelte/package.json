{
  "name": "@editkit/svelte",
  "version": "1.0.6",
  "description": "Svelte and SvelteKit rich text editor action with tables, color picker, and no third-party editor engine. Supports Svelte 3, 4, and 5.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashikurweb/editKit-text-editor.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/ashikurweb/editKit-text-editor#readme",
  "bugs": {
    "url": "https://github.com/ashikurweb/editKit-text-editor/issues"
  },
  "keywords": [
    "editkit",
    "editkit-text-editor",
    "editkit-svelte",
    "@editkit/svelte",
    "svelte",
    "svelte5",
    "svelte-editor",
    "svelte-rich-text-editor",
    "rich-text-editor",
    "wysiwyg",
    "wysiwyg-editor",
    "sveltekit",
    "table-editor",
    "contenteditable",
    "zero-dependencies"
  ],
  "license": "MIT",
  "author": "Ashikur Rahman",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --target es2022 --external @editkit/core --external @editkit/ui --external svelte",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "svelte": "^3.0.0 || ^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "dependencies": {
    "@editkit/core": "workspace:*",
    "@editkit/ui": "workspace:*"
  },
  "devDependencies": {
    "svelte": "^5.2.7",
    "typescript": "^5.8.3"
  }
}
