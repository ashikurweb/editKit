{
  "name": "@editkit/svelte",
  "version": "1.0.2",
  "description": "Official Svelte integration for EditKit Rich Text Editor",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "editkit",
    "svelte",
    "svelte-editor",
    "sveltekit",
    "wysiwyg",
    "rich-text"
  ],
  "license": "MIT",
  "author": "Ashikur",
  "peerDependencies": {
    "svelte": ">=3.0.0 || ^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "dependencies": {
    "@editkit/core": "workspace:*",
    "@editkit/ui": "workspace:*"
  },
  "devDependencies": {
    "svelte": "^5.2.7",
    "typescript": "^5.8.3"
  }
}
