{
  "name": "editkit-text-editor",
  "version": "1.0.8",
  "description": "Customizable TypeScript rich text and WYSIWYG editor with tables for React, Next.js, Vue, Nuxt, Svelte, SvelteKit, Angular, Laravel, and vanilla JavaScript.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "style": "./src/styles.css",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./types/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./types/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./types/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./types/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./svelte": {
      "import": {
        "types": "./types/svelte.d.ts",
        "default": "./dist/svelte.js"
      },
      "require": {
        "types": "./types/svelte.d.cts",
        "default": "./dist/svelte.cjs"
      }
    },
    "./styles": {
      "types": "./types/styles.d.ts",
      "default": "./src/styles.css"
    },
    "./styles.css": {
      "types": "./types/styles.d.ts",
      "default": "./src/styles.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/styles.css",
    "types",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./src/styles.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashikurweb/editKit-text-editor.git"
  },
  "homepage": "https://github.com/ashikurweb/editKit-text-editor#readme",
  "bugs": {
    "url": "https://github.com/ashikurweb/editKit-text-editor/issues"
  },
  "keywords": [
    "editkit-text-editor",
    "editkit",
    "rich-text-editor",
    "wysiwyg-editor",
    "html-editor",
    "text-editor",
    "typescript-editor",
    "javascript-editor",
    "react-rich-text-editor",
    "nextjs-rich-text-editor",
    "vue-rich-text-editor",
    "nuxt-rich-text-editor",
    "svelte-rich-text-editor",
    "sveltekit-rich-text-editor",
    "angular-rich-text-editor",
    "laravel-rich-text-editor",
    "inertiajs",
    "contenteditable",
    "headless-editor",
    "document-editor",
    "table-editor",
    "tiptap-alternative",
    "quill-alternative",
    "lexical-alternative"
  ],
  "license": "MIT",
  "author": "Ashikur Rahman",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build && pnpm run build:package",
    "build:package": "tsup src/index.ts src/react.ts src/vue.ts src/svelte.ts --format esm,cjs --sourcemap --clean --target es2022 --external @editkit/core --external @editkit/ui --external @editkit/react --external @editkit/vue --external @editkit/svelte --external react --external react-dom --external vue --external svelte",
    "prepack": "pnpm build",
    "test": "pnpm verify",
    "test:dropdown": "node --test scripts/dropdown-transition.test.mjs",
    "test:hydration": "node --test scripts/content-hydration.test.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "verify": "pnpm typecheck && pnpm test:dropdown && pnpm build && pnpm test:hydration && pnpm test:package",
    "playground": "pnpm --filter @editkit/playground dev",
    "clean": "turbo run clean"
  },
  "dependencies": {
    "@editkit/core": "workspace:*",
    "@editkit/react": "workspace:*",
    "@editkit/svelte": "workspace:*",
    "@editkit/ui": "workspace:*",
    "@editkit/vue": "workspace:*"
  },
  "devDependencies": {
    "linkedom": "0.18.12",
    "tsup": "^8.5.1",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@11.23.0"
}
